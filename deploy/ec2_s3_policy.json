{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteRoadGuardPrivateRunObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::roadguard-ai-mumbai-2026-123/incoming/*",
        "arn:aws:s3:::roadguard-ai-mumbai-2026-123/reports/*",
        "arn:aws:s3:::roadguard-ai-mumbai-2026-123/reviews/*"
      ]
    },
    {
      "Sid": "ListDedicatedRoadGuardBucketForMissingObjects",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::roadguard-ai-mumbai-2026-123"
    }
  ]
}
