{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadIncomingRoadGuardTraces",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/incoming/*/inspection_trace.json"
    },
    {
      "Sid": "WriteRoadGuardReviewReports",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/reports/*"
    }
  ]
}
